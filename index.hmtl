<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pixelverse — Clicker & Carte géante</title>
<style>
:root{--bg:#090d18;--panel:#111a2b;--panel2:#17243a;--line:#263752;--text:#edf5ff;--muted:#8ea4c2;--cyan:#39e7dc;--gold:#ffd166;--purple:#9c7bff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#17233d 0,#090d18 60%);color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif;height:100vh;overflow:hidden}
button,input{font:inherit}button{cursor:pointer;transition:transform .12s,border-color .2s,background .2s}button:active{transform:scale(.97)}
#app{height:100%;display:flex;flex-direction:column}.topbar{height:74px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 22px;background:#0a1020eF;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}
.brand{display:flex;align-items:center;gap:11px;font-weight:900;letter-spacing:1px}.logo{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,var(--cyan),#5a75ff);color:#07111c;font-size:22px;box-shadow:0 0 22px #39e7dc44}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:2px;margin-top:3px}
.stats{display:flex;gap:9px;align-items:center}.stat{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:8px 13px;min-width:94px}.stat span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1px}.stat strong{font-size:18px;color:var(--gold)}
.main{flex:1;min-height:0;display:flex}.sidebar{width:220px;flex-shrink:0;background:#0c1323;border-right:1px solid var(--line);padding:18px 12px;display:flex;flex-direction:column;gap:8px}.nav{border:1px solid transparent;background:transparent;color:var(--muted);padding:13px 14px;text-align:left;border-radius:11px;font-weight:750}.nav.active{color:var(--text);background:linear-gradient(90deg,#173344,#17243a);border-color:#2a5964;box-shadow:inset 3px 0 var(--cyan)}.side-bottom{margin-top:auto;padding:13px;background:var(--panel);border:1px solid var(--line);border-radius:12px;color:var(--muted);font-size:12px;line-height:1.6}.side-bottom b{color:var(--cyan)}
.content{position:relative;flex:1;min-width:0;min-height:0}.view{display:none;width:100%;height:100%;overflow:auto}.view.active{display:block}
#clicker-view{padding:clamp(16px,3vw,38px);display:none}#clicker-view.active{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(250px,.8fr);gap:22px;align-items:stretch}
.hero,.upgrade-panel,.mission-panel{background:linear-gradient(145deg,#121e32,#0e1626);border:1px solid var(--line);border-radius:22px;position:relative;overflow:hidden}.hero{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:390px;padding:24px}.eyebrow{font-size:11px;letter-spacing:3px;color:var(--cyan);font-weight:900}.hero h1{font-size:clamp(26px,4vw,46px);margin:12px 0 4px;text-align:center}.sub{color:var(--muted);text-align:center;line-height:1.5}.coin-button{margin:28px 0 18px;width:clamp(145px,20vw,205px);aspect-ratio:1;border-radius:50%;border:7px solid #fff2bd;background:radial-gradient(circle at 35% 27%,#fff2a8 0,#ffd166 26%,#d98c18 68%,#88500d 100%);color:#533300;font-size:26px;font-weight:1000;box-shadow:0 0 0 10px #ffd16614,0 0 50px #ffd16636,inset 0 5px 10px #fff9;position:relative}.coin-button:before{content:"";position:absolute;inset:12px;border:2px dashed #8b5a14;border-radius:50%;opacity:.65}.coin-button span{position:relative}.coin-button:hover{filter:brightness(1.08);box-shadow:0 0 0 13px #ffd1661b,0 0 70px #ffd16655}.hero-bottom{display:flex;gap:9px;flex-wrap:wrap;justify-content:center}.pill{border:1px solid var(--line);border-radius:999px;padding:8px 12px;color:var(--muted);font-size:12px}.pill b{color:var(--gold)}
.right-column{display:flex;flex-direction:column;gap:18px;min-height:0}.upgrade-panel,.mission-panel{padding:19px}.section-title{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:13px}.section-title h2{font-size:16px;margin:0}.section-title small{color:var(--muted)}.upgrade-list{display:flex;flex-direction:column;gap:9px}.upgrade{display:flex;align-items:center;gap:11px;padding:12px;background:#101a2b;border:1px solid #263752;border-radius:13px}.upgrade-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:11px;background:#24334d;font-size:21px;flex-shrink:0}.upgrade-info{flex:1;min-width:0}.upgrade-info b{display:block;font-size:13px}.upgrade-info small{display:block;color:var(--muted);font-size:11px;margin-top:4px}.buy{background:#163e49;border:1px solid #2c777a;color:#aafff5;border-radius:9px;padding:9px 10px;font-size:12px;font-weight:850;min-width:76px}.buy:disabled{opacity:.4;cursor:not-allowed}.mission{padding:10px 0;border-bottom:1px solid #243047;font-size:12px;color:var(--muted)}.mission:last-child{border:0}.mission b{float:right;color:var(--gold)}
#map-view{position:relative;overflow:hidden;background:#070b13}canvas{width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}.map-hud{position:absolute;top:14px;left:14px;display:flex;flex-direction:column;gap:8px;pointer-events:none}.hud-card{background:#0a1020eF;border:1px solid #2b3c59;border-radius:12px;padding:11px 14px;box-shadow:0 8px 28px #0005;font-size:12px;line-height:1.6}.hud-card b{color:var(--cyan)}.map-tools{position:absolute;right:14px;top:14px;display:flex;flex-direction:column;gap:7px}.tool-btn{width:42px;height:42px;border:1px solid #354765;background:#0b1425eF;color:white;border-radius:11px;font-size:20px}.map-bottom{position:absolute;bottom:14px;left:14px;right:14px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px;pointer-events:none}.map-bottom>*{pointer-events:auto}.color-card{display:flex;align-items:center;gap:9px;background:#0a1020eF;border:1px solid #2b3c59;padding:9px 12px;border-radius:12px;font-size:12px}.color-card input{width:34px;height:32px;border:0;background:none;padding:0}.map-hint{max-width:340px;background:#0a1020eF;border:1px solid #2b3c59;border-radius:12px;padding:10px 13px;color:var(--muted);font-size:11px;line-height:1.5}.toast{position:absolute;left:50%;top:22px;transform:translate(-50%,-20px);opacity:0;pointer-events:none;background:#152b3b;border:1px solid #39e7dc;color:white;padding:11px 16px;border-radius:12px;font-weight:800;z-index:10;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}
.modal-backdrop{position:absolute;inset:0;background:#050811c9;display:none;place-items:center;z-index:20;padding:18px}.modal-backdrop.open{display:grid}.modal{max-width:450px;width:100%;padding:25px;background:#111b2d;border:1px solid #354765;border-radius:20px;box-shadow:0 25px 80px #0009}.modal h2{margin-top:0}.modal p{color:var(--muted);line-height:1.6;font-size:13px}.modal-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}.secondary{padding:10px 13px;border:1px solid var(--line);border-radius:10px;color:var(--text);background:#1a2940}.danger{border-color:#76434b;background:#3b202a;color:#ffb5c0}
@media(max-width:800px){.topbar{padding:10px 12px;height:66px}.brand{font-size:13px}.logo{width:34px;height:34px}.stat{min-width:68px;padding:7px 9px}.stat strong{font-size:15px}.stat span{font-size:9px}.main{flex-direction:column-reverse}.sidebar{width:100%;height:62px;flex-direction:row;padding:6px;gap:6px;border-right:0;border-top:1px solid var(--line)}.nav{flex:1;text-align:center;padding:10px 5px;font-size:11px}.side-bottom{display:none}.content{flex:1;min-height:0}#clicker-view.active{grid-template-columns:1fr;overflow:auto;align-content:start;padding:12px;gap:12px}.hero{min-height:345px;padding:18px}.coin-button{margin:19px 0 13px}.right-column{display:grid;grid-template-columns:1fr;gap:12px}.upgrade-panel,.mission-panel{padding:14px}.upgrade-list{display:grid;grid-template-columns:1fr 1fr}.upgrade{padding:9px;flex-wrap:wrap}.upgrade-icon{width:34px;height:34px;font-size:17px}.upgrade-info{min-width:80px}.buy{width:100%}.map-hint{display:none}.map-bottom{bottom:9px;left:9px;right:9px}.map-hud{top:9px;left:9px}.hud-card{padding:8px 10px}.map-tools{top:9px;right:9px}.tool-btn{width:38px;height:38px}}
@media(max-width:420px){.brand small{display:none}.stats{gap:5px}.stat{min-width:60px}.upgrade-list{grid-template-columns:1fr}.upgrade{flex-wrap:nowrap}.buy{width:auto}.hero h1{font-size:26px}}
</style>
</head>
<body>
<div id="app">
<header class="topbar">
  <div class="brand"><div class="logo">✦</div><div>PIXELVERSE<small>CLICK • BUILD • EXPLORE</small></div></div>
  <div class="stats">
    <div class="stat"><span>🪙 Coins</span><strong id="coin-count">0</strong></div>
    <div class="stat"><span>⚡ Par clic</span><strong id="per-click">+1</strong></div>
    <div class="stat"><span>⏱️ Par sec.</span><strong id="per-sec">0</strong></div>
  </div>
</header>
<div class="main">
  <aside class="sidebar">
    <button class="nav active" data-view="clicker-view">⛏️ &nbsp; MINER</button>
    <button class="nav" data-view="map-view">🗺️ &nbsp; CARTE GÉANTE</button>
    <div class="side-bottom">Bienvenue dans <b>Pixelverse</b>.<br>Mine des coins, achète des améliorations et laisse ta marque sur la carte de <b>1 000 000 × 1 000 000</b> pixels.</div>
  </aside>
  <main class="content">
    <section id="clicker-view" class="view active">
      <div class="hero">
        <div class="eyebrow">CENTRE DE MINAGE</div>
        <h1>Un clic. Un univers.</h1>
        <p class="sub">Récolte des coins pour construire ton empire pixel.</p>
        <button id="clicker-btn" class="coin-button" aria-label="Miner des coins"><span>✦ MINE !</span></button>
        <div class="hero-bottom">
          <div class="pill">Total miné : <b id="total-mined">0</b></div>
          <div class="pill">Pixels posés : <b id="pixel-count">0</b></div>
          <div class="pill">Bonus clic : <b id="bonus-label">x1</b></div>
        </div>
      </div>
      <div class="right-column">
        <section class="upgrade-panel">
          <div class="section-title"><h2>🚀 Améliorations</h2><small>Investis tes coins</small></div>
          <div id="upgrade-list" class="upgrade-list"></div>
        </section>
        <section class="mission-panel">
          <div class="section-title"><h2>🎯 Missions</h2><small>Récompenses bonus</small></div>
          <div id="missions"></div>
        </section>
      </div>
    </section>
    <section id="map-view" class="view">
      <canvas id="mapCanvas" aria-label="Carte pixel géante"></canvas>
      <div class="map-hud">
        <div class="hud-card"><b>PIXELVERSE MAP</b><br>Coord. <span id="coord-x">500000</span>, <span id="coord-y">500000</span><br>Zoom <span id="zoom-label">10×</span></div>
        <div class="hud-card">🖱️ Glisser : déplacer<br>🔍 Molette / pincement : zoom<br>🎨 Clic : placer un pixel (1 coin)</div>
      </div>
      <div class="map-tools"><button class="tool-btn" id="zoom-in" title="Zoom avant">＋</button><button class="tool-btn" id="zoom-out" title="Zoom arrière">−</button><button class="tool-btn" id="center-map" title="Recentrer">⌖</button><button class="tool-btn" id="clear-map" title="Effacer mes pixels">⌫</button></div>
      <div class="map-bottom">
        <div class="color-card"><label for="color-picker">Couleur</label><input type="color" id="color-picker" value="#39e7dc"><span id="color-label">#39E7DC</span></div>
        <div class="map-hint">Astuce : zoom avant pour dessiner avec précision. La carte est immense, mais seuls les pixels explorés sont enregistrés dans cette session.</div>
      </div>
    </section>
    <div id="toast" class="toast"></div>
    <div id="clear-modal" class="modal-backdrop"><div class="modal"><h2>Effacer tes pixels ?</h2><p>Cette action enlèvera tous les pixels que tu as placés sur la carte pendant cette session. Les coins dépensés ne seront pas remboursés.</p><div class="modal-actions"><button class="secondary" id="cancel-clear">Annuler</button><button class="secondary danger" id="confirm-clear">Effacer la carte</button></div></div></div>
  </main>
</div>
</div>
<script>
(() => {
  'use strict';
  const $ = id => document.getElementById(id);
  const MAP_SIZE = 1_000_000;
  const SAVE_KEY = 'pixelverse-save-v1';
  const upgrades = [
    {id:'pickaxe',icon:'⛏️',name:'Pioche en titane',desc:'+1 coin par clic',base:25,scale:1.55,type:'click',amount:1},
    {id:'drone',icon:'🤖',name:'Drone mineur',desc:'+1 coin par seconde',base:60,scale:1.6,type:'auto',amount:1},
    {id:'laser',icon:'🔆',name:'Laser quantique',desc:'+5 coins par clic',base:180,scale:1.75,type:'click',amount:5},
    {id:'factory',icon:'🏭',name:'Usine de pixels',desc:'+8 coins par seconde',base:350,scale:1.8,type:'auto',amount:8}
  ];
  let coins=0,totalMined=0,clickPower=1,autoPower=0,bonus=1,pixels=new Map(),owned={},lastTick=Date.now();
  let zoom=10,cameraX=MAP_SIZE/2,cameraY=MAP_SIZE/2,isDragging=false,dragged=false,lastX=0,lastY=0,pointers=new Map(),pinchStart=0,pinchZoom=10;
  let toastTimer;
  const canvas=$('mapCanvas'),ctx=canvas.getContext('2d');
  function fmt(n){return Math.floor(n).toLocaleString('fr-CA');}
  function updateUI(){
    $('coin-count').textContent=fmt(coins);$('per-click').textContent='+'+fmt(clickPower*bonus);$('per-sec').textContent=fmt(autoPower);
    $('total-mined').textContent=fmt(totalMined);$('pixel-count').textContent=fmt(pixels.size);$('bonus-label').textContent='x'+bonus;
    upgrades.forEach(u=>{const price=priceOf(u),el=$('buy-'+u.id);if(el){el.textContent=fmt(price)+' 🪙';el.disabled=coins<price;}});
    updateMissions();
  }
  function priceOf(u){return Math.floor(u.base*Math.pow(u.scale,owned[u.id]||0));}
  function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2100);}
  function save(){try{localStorage.setItem(SAVE_KEY,JSON.stringify({coins,totalMined,clickPower,autoPower,bonus,owned,pixels:[...pixels.entries()]}));}catch(e){}}
  function load(){try{const d=JSON.parse(localStorage.getItem(SAVE_KEY)||'null');if(!d)return;coins=Math.max(0,Number(d.coins)||0);totalMined=Math.max(0,Number(d.totalMined)||0);clickPower=Math.max(1,Number(d.clickPower)||1);autoPower=Math.max(0,Number(d.autoPower)||0);bonus=Math.max(1,Number(d.bonus)||1);owned=d.owned&&typeof d.owned==='object'?d.owned:{};pixels=new Map(Array.isArray(d.pixels)?d.pixels:[]);}catch(e){toast('Sauvegarde indisponible');}}
  function renderUpgrades(){
    $('upgrade-list').innerHTML='';
    upgrades.forEach(u=>{
      const row=document.createElement('div');row.className='upgrade';
      row.innerHTML=`<div class="upgrade-icon">${u.icon}</div><div class="upgrade-info"><b>${u.name}</b><small>${u.desc} · Niveau ${owned[u.id]||0}</small></div><button class="buy" id="buy-${u.id}">${fmt(priceOf(u))} 🪙</button>`;
      row.querySelector('button').addEventListener('click',()=>buyUpgrade(u));$('upgrade-list').appendChild(row);
    });updateUI();
  }
  function buyUpgrade(u){
    const cost=priceOf(u);if(coins<cost){toast('Pas assez de coins !');return;}coins-=cost;owned[u.id]=(owned[u.id]||0)+1;
    if(u.type==='click')clickPower+=u.amount;else autoPower+=u.amount;
    toast(`${u.icon} ${u.name} amélioré !`);renderUpgrades();save();
  }
  function mine(){const gain=clickPower*bonus;coins+=gain;totalMined+=gain;updateUI();save();const b=$('clicker-btn');b.animate([{transform:'scale(1)'},{transform:'scale(.94)'},{transform:'scale(1)'}],{duration:140});}
  $('clicker-btn').addEventListener('click',mine);
  document.querySelectorAll('.nav').forEach(btn=>btn.addEventListener('click',()=>{
    document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x===btn));
    document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===btn.dataset.view));
    if(btn.dataset.view==='map-view')resizeCanvas();
  }));
  function updateMissions(){
    const tasks=[{label:'Miner 100 coins',goal:100,progress:totalMined,reward:20,id:'m1'},{label:'Poser 10 pixels',goal:10,progress:pixels.size,reward:35,id:'m2'},{label:'Acheter 3 améliorations',goal:3,progress:Object.values(owned).reduce((a,b)=>a+(Number(b)||0),0),reward:50,id:'m3'}];
    let claimed={};try{claimed=JSON.parse(localStorage.getItem(SAVE_KEY+'-missions')||'{}')}catch(e){}
    $('missions').innerHTML='';
    tasks.forEach(t=>{const done=t.progress>=t.goal,was=!!claimed[t.id];const div=document.createElement('div');div.className='mission';div.innerHTML=`${done&&!was?'<button class="buy" style="float:right;padding:4px 7px" data-claim="'+t.id+'">Réclamer</button>':''}${t.label}<b>${was?'✓ Réclamé':fmt(Math.min(t.progress,t.goal))+'/'+t.goal+' · +'+t.reward}</b>`;
      const claim=div.querySelector('[data-claim]');if(claim)claim.addEventListener('click',()=>{coins+=t.reward;totalMined+=t.reward;claimed[t.id]=true;localStorage.setItem(SAVE_KEY+'-missions',JSON.stringify(claimed));toast('Mission terminée : +'+t.reward+' coins !');updateUI();save();});$('missions').appendChild(div);});
  }
  function resizeCanvas(){if(!$('map-view').classList.contains('active'))return;const r=canvas.getBoundingClientRect();if(!r.width||!r.height)return;const dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=Math.round(r.width*dpr);canvas.height=Math.round(r.height*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);drawMap();}
  function viewSize(){const r=canvas.getBoundingClientRect();return {w:r.width,h:r.height};}
  function drawMap(){
    const {w,h}=viewSize();if(!w||!h)return;ctx.clearRect(0,0,w,h);ctx.fillStyle='#070b13';ctx.fillRect(0,0,w,h);
    const left=cameraX-w/(2*zoom),right=cameraX+w/(2*zoom),top=cameraY-h/(2*zoom),bottom=cameraY+h/(2*zoom);
    if(zoom>=4){ctx.strokeStyle='#1a2738';ctx.lineWidth=1/Math.max(zoom,1);ctx.beginPath();const step=zoom<9?5:1;
      for(let x=Math.max(0,Math.floor(left/step)*step);x<=Math.min(MAP_SIZE,Math.ceil(right));x+=step){const sx=(x-cameraX)*zoom+w/2;ctx.moveTo(sx,0);ctx.lineTo(sx,h);}
      for(let y=Math.max(0,Math.floor(top/step)*step);y<=Math.min(MAP_SIZE,Math.ceil(bottom));y+=step){const sy=(y-cameraY)*zoom+h/2;ctx.moveTo(0,sy);ctx.lineTo(w,sy);}ctx.stroke();}
    for(const [key,color] of pixels){const comma=key.indexOf(',');const x=+key.slice(0,comma),y=+key.slice(comma+1);if(x<left-1||x>right+1||y<top-1||y>bottom+1)continue;const sx=(x-cameraX)*zoom+w/2,sy=(y-cameraY)*zoom+h/2;ctx.fillStyle=color;ctx.fillRect(Math.floor(sx),Math.floor(sy),Math.max(1,Math.ceil(zoom)),Math.max(1,Math.ceil(zoom)));}
    $('coord-x').textContent=fmt(Math.max(0,Math.min(MAP_SIZE-1,Math.floor(cameraX))));$('coord-y').textContent=fmt(Math.max(0,Math.min(MAP_SIZE-1,Math.floor(cameraY))));$('zoom-label').textContent=zoom.toFixed(zoom<1?2:1)+'×';
  }
  function worldAt(sx,sy){const {w,h}=viewSize();return{x:Math.floor((sx-w/2)/zoom+cameraX),y:Math.floor((sy-h/2)/zoom+cameraY)};}
  function pointerPos(e){const r=canvas.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top};}
  function setZoom(newZoom,anchorX,anchorY){const old=zoom;newZoom=Math.max(.1,Math.min(100,newZoom));if(newZoom===old)return;const {w,h}=viewSize();const wx=(anchorX-w/2)/old+cameraX,wy=(anchorY-h/2)/old+cameraY;zoom=newZoom;cameraX=wx-(anchorX-w/2)/zoom;cameraY=wy-(anchorY-h/2)/zoom;clampCamera();drawMap();}
  function clampCamera(){cameraX=Math.max(0,Math.min(MAP_SIZE,cameraX));cameraY=Math.max(0,Math.min(MAP_SIZE,cameraY));}
  canvas.addEventListener('pointerdown',e=>{canvas.setPointerCapture(e.pointerId);pointers.set(e.pointerId,pointerPos(e));if(pointers.size===1){isDragging=true;dragged=false;const p=pointerPos(e);lastX=p.x;lastY=p.y;}else if(pointers.size===2){isDragging=false;const ps=[...pointers.values()];pinchStart=Math.hypot(ps[0].x-ps[1].x,ps[0].y-ps[1].y);pinchZoom=zoom;}});
  canvas.addEventListener('pointermove',e=>{if(!pointers.has(e.pointerId))return;const p=pointerPos(e),prev=pointers.get(e.pointerId);pointers.set(e.pointerId,p);
    if(pointers.size>=2){const ps=[...pointers.values()];const dist=Math.hypot(ps[0].x-ps[1].x,ps[0].y-ps[1].y);if(pinchStart>0){const midX=(ps[0].x+ps[1].x)/2,midY=(ps[0].y+ps[1].y)/2;setZoom(pinchZoom*dist/pinchStart,midX,midY);}return;}
    if(isDragging){const dx=p.x-lastX,dy=p.y-lastY;if(Math.abs(dx)+Math.abs(dy)>2)dragged=true;cameraX-=dx/zoom;cameraY-=dy/zoom;clampCamera();lastX=p.x;lastY=p.y;drawMap();}});
  function endPointer(e){const p=pointerPos(e);pointers.delete(e.pointerId);if(pointers.size<2)pinchStart=0;if(pointers.size===0){if(isDragging&&!dragged){const world=worldAt(p.x,p.y);if(world.x>=0&&world.x<MAP_SIZE&&world.y>=0&&world.y<MAP_SIZE){const key=world.x+','+world.y,color=$('color-picker').value;if(pixels.get(key)===color){toast('Ce pixel a déjà cette couleur.');}else if(coins<1){toast('Pas assez de coins : retourne miner !');}else{pixels.set(key,color);coins--;updateUI();drawMap();save();}}}isDragging=false;}}
  canvas.addEventListener('pointerup',endPointer);canvas.addEventListener('pointercancel',endPointer);
  canvas.addEventListener('wheel',e=>{e.preventDefault();const p=pointerPos(e);setZoom(zoom*(e.deltaY<0?1.2:1/1.2),p.x,p.y);},{passive:false});
  $('zoom-in').addEventListener('click',()=>{const {w,h}=viewSize();setZoom(zoom*1.5,w/2,h/2);});
  $('zoom-out').addEventListener('click',()=>{const {w,h}=viewSize();setZoom(zoom/1.5,w/2,h/2);});
  $('center-map').addEventListener('click',()=>{cameraX=MAP_SIZE/2;cameraY=MAP_SIZE/2;zoom=10;drawMap();toast('Carte recentrée');});
  $('clear-map').addEventListener('click',()=>$('clear-modal').classList.add('open'));
  $('cancel-clear').addEventListener('click',()=>$('clear-modal').classList.remove('open'));
  $('confirm-clear').addEventListener('click',()=>{pixels.clear();$('clear-modal').classList.remove('open');updateUI();drawMap();save();toast('Tes pixels ont été effacés.');});
  $('clear-modal').addEventListener('click',e=>{if(e.target===$('clear-modal'))$('clear-modal').classList.remove('open');});
  $('color-picker').addEventListener('input',e=>{$('color-label').textContent=e.target.value.toUpperCase();});
  window.addEventListener('resize',resizeCanvas);
  load();renderUpgrades();updateUI();
  setInterval(()=>{const now=Date.now(),elapsed=Math.min((now-lastTick)/1000,5);lastTick=now;if(autoPower>0){const gain=autoPower*elapsed;coins+=gain;totalMined+=gain;updateUI();save();}},250);
  window.addEventListener('beforeunload',save);
})();
</script>
</body>
</html>
